rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/countdowns/{countdownId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validClock() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'name', 'target', 'createdAt'])
          && d.keys().hasOnly(['id', 'name', 'target', 'createdAt'])
          && d.id == countdownId
          && d.name is string && d.name.size() > 0 && d.name.size() <= 65
          && d.target is number && d.target > 0 && d.target <= 8640000000000000
          && d.createdAt is number && d.createdAt > 0 && d.createdAt <= 8640000000000000;
      }
      allow read, delete: if owner();
      allow create, update: if owner() && validClock();
    }
  }
}
